# Copy this file to .env (same folder) and fill in the values. .env is git-ignored.
# Inline comments after a value are NOT allowed by python-dotenv, so keep comments on their own line.

# LLM used for answers (C0 and C1 use the same model): openai | anthropic | openai_compatible
LLM_PROVIDER=
# Model id for the chosen provider, exactly as the provider names it.
LLM_MODEL=

# Needed only if LLM_PROVIDER=openai or EMBEDDINGS=openai
OPENAI_API_KEY=
# Needed only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Needed only if LLM_PROVIDER=openai_compatible (any OpenAI-compatible chat-completions server).
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ and LLM_API_KEY = Gemini API key
LLM_BASE_URL=
LLM_API_KEY=

# Optional: low | medium | high. Sent only when set (openai / openai_compatible only).
LLM_REASONING_EFFORT=

# Embeddings: bge_m3_local (default, no key) or openai (then also set OPENAI_API_KEY and OPENAI_EMBED_MODEL)
EMBEDDINGS=bge_m3_local
OPENAI_EMBED_MODEL=

# Optional: cpu (default) or cuda for local BGE-M3 embeddings
EMBED_DEVICE=cpu
# Optional: Hugging Face model cache (about 2.3 GB). Empty = .cache\huggingface inside this repo.
HF_HOME=
